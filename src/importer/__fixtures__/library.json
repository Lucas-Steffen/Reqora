{
  "swagger": "2.0",
  "info": {
    "title": "Library Catalog",
    "version": "2.0.0"
  },
  "host": "library.test",
  "basePath": "/api",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "Books",
      "description": "Book records"
    }
  ],
  "securityDefinitions": {
    "basic": {
      "type": "basic"
    },
    "token": {
      "type": "apiKey",
      "in": "query",
      "name": "token"
    }
  },
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Search books",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "type": "string",
            "x-example": "dune"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Book"
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Add book",
        "parameters": [
          {
            "name": "book",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Book"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "id": "b1"
              }
            }
          }
        }
      }
    },
    "/books/{id}/cover": {
      "put": {
        "tags": [
          "Books"
        ],
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "image",
            "in": "formData",
            "type": "file"
          }
        ],
        "responses": {
          "204": {
            "description": "Saved"
          }
        }
      }
    }
  },
  "definitions": {
    "Book": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "example": "Dune"
        }
      }
    }
  }
}
